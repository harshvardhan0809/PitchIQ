# Football-Data.org v4 token (https://www.football-data.org/client/register).
# Required: without it the competition endpoints return 503.
FOOTBALL_DATA_API_KEY=your_token_here

# Server
API_PORT=3001
API_HOST=127.0.0.1

# Comma-separated origins allowed to call the API. Leave unset to allow any
# origin (fine locally). In production set this to your frontend URL, otherwise
# the proxy hands your metered provider quota to arbitrary callers.
# ALLOWED_ORIGINS=https://pitchiq-1.onrender.com

# Upper bound on cached upstream responses held in memory.
# CACHE_MAX_ENTRIES=400

# Self-imposed rate limits, kept just under each provider's ceiling. A burst
# waits for a slot instead of tripping the provider; only requests that would
# wait longer than the max get a retryable 429. Football-Data's free tier is
# 10 requests/minute — raise the limit if you move to a paid plan.
# FOOTBALL_DATA_RATE_LIMIT=8
# FOOTBALL_DATA_MAX_WAIT_MS=10000
# FPL_RATE_LIMIT=30
# FPL_MAX_WAIT_MS=15000

# --- Authentication (Supabase) ---------------------------------------------
# Accounts, login and sessions are handled by Supabase. Create a project at
# https://supabase.com, then copy these from Project Settings → API. Without
# them, accounts are disabled and every request is served the free tier.
#
# Server (never exposed to the browser):
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # required to grant plans; keep secret
#
# Client (safe to expose — anon key is public by design):
# VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Plans ------------------------------------------------------------------
# Two tiers: Free and Pro. Pro is granted only by a verified Razorpay payment
# (below) or manually from the /admin console — there are no access codes.

# Emails allowed into the /admin console (server-enforced, by email not plan).
# ADMIN_EMAILS=you@example.com

# --- Billing (Razorpay) -----------------------------------------------------
# Real card & UPI subscriptions. Create an account at https://razorpay.com,
# then in the dashboard create a Subscription *Plan* (its price + currency —
# e.g. ₹399/month) and copy its id below. Keys are under Settings → API Keys;
# the webhook secret is set when you add a webhook pointing at
# <your-api-url>/api/billing/webhook (subscribe to the subscription.* events).
# All server-side — never expose the key secret or webhook secret to the browser.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=your-key-secret
# RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
# RAZORPAY_PLAN_ID=plan_xxxxxxxx

# Use the local proxy instead of the bundled sample dataset.
VITE_DATA_MODE=live

# Point the frontend at a different API host (defaults to same origin).
# VITE_API_URL=https://pitchiq-bqrr.onrender.com
